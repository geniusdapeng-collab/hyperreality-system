{
  "schemaVersion": "workloom.acceptance-profile/v2",
  "repo": "workloom-ai/<repo>",
  "productName": "<产品名>",
  "lane": "base|platform|industry|experiment",
  "primaryBundle": "<bundles 下的主包目录名>",
  "workspaceId": null,
  "dataMode": "simulated",
  "startup": {
    "command": "pnpm preview:all",
    "ports": { "pc": 3000, "bMobile": 3001, "cMobile": 3002, "server": 8787 }
  },
  "identity": {
    "human": "MEM-001",
    "guest": "demo-direct",
    "workspaceSlug": "ws-<demo>"
  },
  "surfaces": {
    "pcRoutes": ["/", "/tasks", "/approvals", "/agents", "/skills", "/events", "/reports", "/guardrails"],
    "bMobileRoutes": ["/", "/inbox", "/tasks", "/operations", "/account"],
    "cRoutes": ["#chat", "#service", "#tickets", "#messages", "#me"]
  },
  "thresholds": {
    "firstValueMs": 20000,
    "dispatchMs": 60000,
    "approvalMs": 30000,
    "traceClicks": 2,
    "guestFirstReplyMs": 30000,
    "decisionQuota": 7,
    "minContrastRatio": 4.5,
    "idleInterruptionWindowS": 20,
    "taskSuccessP0": 1.0,
    "taskSuccessP1": 0.9,
    "susMin": 68,
    "susTarget": 80,
    "seqMin": 5.5,
    "csatMin": 4.2,
    "targetSizePx": 24,
    "zoomPercent": 200,
    "axCritical": 0,
    "adr1Target": 0.85,
    "hirNiMax": 0.1,
    "h34Max": 0.03,
    "hmpoMax": 0.5,
    "passK": 5,
    "p0PassKTarget": 0.8,
    "offlineAuditSample": 10,
    "soakHours": 24
  },
  "ux": {
    "personas": [
      { "id": "owner", "jtbd": ["每天 10 分钟看清经营与风险"], "criticality": "P0" },
      { "id": "manager", "jtbd": ["今天要处理什么、谁在做、卡在哪"], "criticality": "P0" },
      { "id": "staff", "jtbd": ["接活、交付、有回执"], "criticality": "P0" },
      { "id": "partner", "jtbd": ["看清我能做什么、不能碰什么"], "criticality": "P1" },
      { "id": "guest", "jtbd": ["问得清、答得快、能联系到人"], "criticality": "P0" }
    ],
    "journeys": [
      { "id": "U-01", "persona": "owner", "stage": "first-run", "title": "首启看到价值与待拍板", "mot": true },
      { "id": "U-02", "persona": "manager", "stage": "day-1", "title": "派活并看到拆解", "mot": true },
      { "id": "U-03", "persona": "owner", "stage": "daily", "title": "审批三手势写回", "mot": true },
      { "id": "U-04", "persona": "owner", "stage": "exception", "title": "紧急制动与恢复", "mot": true },
      { "id": "U-05", "persona": "guest", "stage": "exception", "title": "C 端首响与转人工", "mot": true }
    ],
    "tasks": [
      { "id": "U2-T01", "persona": "manager", "criticality": "P0", "budgetMs": 60000, "paths": ["normal", "error", "offline"] },
      { "id": "U2-T02", "persona": "owner", "criticality": "P0", "budgetMs": 30000, "paths": ["normal", "boundary", "permission"] }
    ],
    "research": {
      "participants": [],
      "methods": ["think-aloud", "first-click", "five-second", "tree-test"],
      "instruments": ["SUS", "SEQ", "NASA-TLX", "CSAT"]
    }
  },
  "outcome": {
    "fixtureMarker": "suite.rdas.<本轮唯一runId>",
    "residualDisclosure": "保留带本轮唯一 marker 的验收线程、事件和回执；按 autonomy.fixtureFilters 从真实经营指标与 ADR/HIR 中排除。",
    "roles": [
      {
        "role": "<岗位 preset_key>",
        "agentPreset": "<preset_key>",
        "al": "AL3",
        "deliverableUnit": "<交付件单位>",
        "minSubstance": "<最小实质标准>",
        "kpis": [{ "name": "<KPI>", "source": "<system>", "baseline": null, "target": null }],
        "attribution": "observational",
        "guardrails": ["csat", "complaints", "refund"]
      }
    ],
    "taskSuites": ["acceptance/outcomes/<role>.yaml"],
    "receipts": ["acceptance/receipts/*.json"]
  },
  "autonomy": {
    "interventionTaxonomy": "H0-H4",
    "fixtureFilters": ["suite.", "suite-", "apr-suite-", "apr-e-", "T-suite"],
    "windows": ["4w"],
    "targetPrecisionPp": 10,
    "offlineAuditSample": 10
  },
  "soak": { "hours": [24, 168, 672], "metrics": ["success", "latency", "cost", "drift"] },
  "environment": {
    "kind": "local-preview",
    "allowWrites": false,
    "supportDir": null,
    "target": {},
    "timeouts": { "healthMs": 8000, "probeMs": 20000 },
    "notes": "local-preview=本机预览（mock 口径）；client-runtime=已安装桌面客户端运行时（默认 server 8787 / web 5173，supportDir 缺省按产品名推导）；deployed=生产部署，必须显式声明 target.{pcUrl,apiUrl}。生产档位默认只读，写入需 --allow-prod-writes。"
  },
  "live": {
    "enabled": false,
    "requireRealModels": false,
    "allowDb": false,
    "budgets": {
      "maxLlmCalls": 40,
      "maxLlmTokens": 300000,
      "maxImages": 8,
      "maxVideoClips": 3,
      "minVideoSeconds": 10,
      "maxVideoSeconds": 15,
      "maxVideoSecondsTotal": 45,
      "maxCostCny": 120,
      "maxWallClockMin": 45
    },
    "models": [
      { "id": "deepseek-v4.1-flash", "kind": "llm", "model": "deepseek-flash", "adapter": "dsh-harness", "apiKeyEnv": "DEEPSEEK_API_KEY", "baseUrlEnv": "DEEPSEEK_BASE_URL", "note": "仅为模型/adapter 配置写法示例，不声明本仓当前可用模型、最新版本或供应商支持；按本轮真实 profile、运行时目录与实际回执填写。" },
      { "id": "seedream-5.0", "kind": "image", "model": "seedream-5.0", "adapter": "gen-http", "apiKeyEnv": "SEEDREAM_API_KEY", "baseUrlEnv": "SEEDREAM_ENDPOINT" },
      { "id": "seedance-2.5", "kind": "video", "model": "seedance-2.5", "adapter": "gen-http", "apiKeyEnv": "SEEDANCE_API_KEY", "baseUrlEnv": "SEEDANCE_ENDPOINT" }
    ],
    "tasks": [
      {
        "id": "LLM-R1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "<本仓真实推理任务>",
        "prompt": "<任务描述；明确成功标准与 TASK_COMPLETE 结尾>",
        "expect": ["<任一命中即可的判定正则>"],
        "expectAll": ["TASK_COMPLETE"]
      },
      {
        "id": "LLM-T1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "<工具循环任务（工具调用过围栏 + 事件落账）>",
        "prompt": "请调用 bash 工具执行 `echo <夹具标记>`，原样贴出输出，最后另起一行输出 TASK_COMPLETE。",
        "expect": ["<夹具标记>|TASK_COMPLETE"],
        "expectAll": ["TASK_COMPLETE"]
      },
      {
        "id": "LLM-M1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P1",
        "title": "<多模态理解任务（截图/商品图）>",
        "prompt": "请打开随附图片，用一句话说明这是什么页面/商品，并给出图中可见的一处细节。最后另起一行输出 TASK_COMPLETE。",
        "fixture": "ui-shot",
        "expect": ["."]
      },
      {
        "id": "IMG-01",
        "kind": "image",
        "model": "seedream-5.0",
        "criticality": "P1",
        "images": 2,
        "title": "<本仓生图任务：海报/定妆照/商品图>",
        "prompt": "<提示词>",
        "minArtifacts": 1
      },
      {
        "id": "VID-01",
        "kind": "video",
        "model": "seedance-2.5",
        "criticality": "P1",
        "durationSeconds": 12,
        "title": "<本仓生视频任务：门店空镜/产品镜头>",
        "prompt": "<提示词>",
        "durationRange": [10, 15]
      },
      {
        "id": "PROD-01",
        "kind": "product",
        "criticality": "P0",
        "title": "<本仓当前工作区经营事实复核>",
        "input": "suite.rdas.<本轮唯一runId>.PROD-01：请根据本工作区当前事实交付经营事实复核摘要，列出事实来源与未核实项；资料不足明确披露，不补造事实。回答须包含本轮完整 marker，以及“事实来源”和“未核实项”两个结果段落。",
        "presetKey": "<岗位 preset_key>",
        "workspaceSlug": "<本仓演示工作区>",
        "requireModel": true,
        "fixtureMarker": "suite.rdas.<本轮唯一runId>.PROD-01",
        "residualDisclosure": "保留带本轮唯一 marker 的产品派单线程、事件和回执；不计入真实经营指标、ADR/HIR，按 fixtureFilters 排除。",
        "state_asserts": [
          { "event": { "action": "ask.answer", "field": "decision.after.text", "contains": "suite.rdas.<本轮唯一runId>.PROD-01", "minLength": 80 } },
          { "event": { "action": "ask.answer", "field": "decision.after.text", "contains": "事实来源" } },
          { "event": { "action": "ask.answer", "field": "decision.after.text", "contains": "未核实项" } }
        ]
      }
    ],
    "notes": "本文件仅为需按仓填写的示例，live 默认关闭；models 中全部 ID/model/版本标签仅展示配置结构，不证明当前可用或已通过。启用前以本轮实际 profile、运行时目录与供应商实际返回/回执逐项核对模型、端点和任务，把 <本轮唯一runId> 替换成每轮不同且一致绑定输入/断言/marker 的值，并填本仓真实 preset/工作区/结果标准。P 域每个实际模型需真实任务与回执；生图/生视频按张、按秒硬计量（图 ≤8 张、视频 ≤3 段且各 10–15s、总 ≤45s）。产品派单当前缺可信服务端逐请求预算接口，requireModel=true 仍会调用前 blocked；不能改为 false 或用健康检查代替业务交付来放行。凭据经环境变量或秘密存储注入，禁止写进 profile 或仓库。"
  },
  "journeys": [
    { "id": "EXP-01", "persona": "owner", "title": "首启看到价值与待拍板", "script": "builtin:first-value" },
    { "id": "EXP-02", "persona": "owner", "title": "审批三手势写回", "script": "builtin:approval" },
    { "id": "EXP-03", "persona": "owner", "title": "一键溯源", "script": "builtin:traceability" },
    { "id": "EXP-04", "persona": "owner", "title": "紧急制动确认与撤回", "script": "builtin:brake" },
    { "id": "EXP-05", "persona": "manager", "title": "派活并看拆解", "script": "builtin:dispatch" },
    { "id": "EXP-06", "persona": "manager", "title": "统一待办聚合", "script": "builtin:inbox" },
    { "id": "EXP-07", "persona": "staff", "title": "移动端接活（390px）", "script": "builtin:mobile-staff" },
    { "id": "EXP-08", "persona": "partner", "title": "伙伴授权边界可见", "script": "builtin:partner-scope" },
    { "id": "EXP-09", "persona": "guest", "title": "C 端首响与转人工", "script": "builtin:guest-service" },
    { "id": "EXP-10", "persona": "owner", "title": "围栏 dry-run", "script": "builtin:dry-run" }
  ],
  "notes": "行业专属补充：角色/旅程/任务/阈值/结果契约请按本仓业务细化；阈值只能收紧不能放宽。"
}
